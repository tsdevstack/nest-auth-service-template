// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String
  firstName           String
  lastName            String
  confirmed           Boolean  @default(false)
  status              UserStatus @default(INACTIVE)
  createdAt           DateTime @default(now())
  systemRole          SystemRole @default(USER)
  roles               String[] @default([]) // Custom roles, declared in src/roles/roles.constants.ts
  confirmationTokens  ConfirmationToken[]
  passwordResetTokens PasswordResetToken[]
  tokenHash           RefreshToken[]
  apiKeys             ApiKey[]
}

model ConfirmationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   // Store the hash, not the raw token
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([tokenHash])
  @@index([userId])
}

model ApiKey {
  id             String        @id @default(cuid())
  name           String
  prefix         String // First 12 characters of the key, display only
  keyHash        String        @unique // sha256 hex of the key; the key itself is never stored
  consumer       String // Who the key is for, e.g. acme-corp; not a user
  createdById    String // Admin who created the key (audit only)
  createdBy      User          @relation(fields: [createdById], references: [id])
  limitPerMinute Int?
  limitPerHour   Int?
  limitPerDay    Int?
  limitPerWeek   Int?
  limitPerMonth  Int?
  status         ApiKeyStatus  @default(ACTIVE)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  usage          ApiKeyUsage[]

  @@index([consumer])
}

model ApiKeyUsage {
  keyId  String
  period String // ISO week (2026-W40) or month (2026-09), UTC
  count  BigInt // Requests admitted in the period (a month can exceed 2^31)
  key    ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([keyId, period])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SystemRole {
  USER
  ADMIN
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}
